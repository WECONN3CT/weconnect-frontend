# ============================================
# WeConnect Frontend - Umgebungsvariablen
# ============================================
# Kopiere diese Datei nach .env.local und passe die Werte an!

# API Backend URL
# Development: http://localhost:3000/api
# Production: https://weconnect-backend-production.up.railway.app/api
VITE_API_URL=http://localhost:3000/api

# App Konfiguration
VITE_APP_NAME=WeConnect
VITE_APP_ENV=development

# Feature Flags (optional)
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_SENTRY=false

# Sentry Error Tracking (optional)
# Hole den DSN von: https://sentry.io
VITE_SENTRY_DSN=

# OAuth Credentials (für Phase 3)
# LinkedIn: https://www.linkedin.com/developers/
# Facebook: https://developers.facebook.com/
VITE_LINKEDIN_CLIENT_ID=
VITE_FACEBOOK_APP_ID=
